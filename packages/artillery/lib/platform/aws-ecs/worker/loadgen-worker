#!/usr/bin/env node
// CJS shim for the Fargate/ACI loadgen worker. ECS task definitions
// hardcode /artillery/loadgen-worker as the container entryPoint, so
// this file keeps its exact path and name. The implementation lives in
// the artillery package's compiled output (ESM), hence dynamic import.
// (Extensionless file => Node treats it as CJS.)
'use strict';
const path = require('node:path');

import(
  path.join(
    __dirname,
    'packages/artillery/dist/lib/platform/aws-ecs/worker/src/index.js'
  )
).catch((err) => {
  console.error(err);
  process.exit(1);
});
